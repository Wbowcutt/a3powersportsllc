{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "a3powersportsllc",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "a3powersportsllc"
    }
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "a3powersportsllc.com",
      "custom_domain": true
    },
    {
      "pattern": "www.a3powersportsllc.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "CONTACT_EMAIL": "a3powersportsllc@gmail.com",
    "NEXT_PUBLIC_SITE_URL": "https://a3powersportsllc.com"
  }
}
