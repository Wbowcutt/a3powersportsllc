# Public site URL. No trailing slash.
# Local: http://localhost:3000
# Live: the Namecheap domain once DNS points at hosting, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cal.com booking link. Username and event slug, or a full cal.com URL.
# Example: asa/service   or   https://cal.com/asa/service
NEXT_PUBLIC_CAL_LINK=

# Resend — contact form and shop order emails.
# Use a restricted send key. Verify RESEND_FROM_EMAIL in the Resend dashboard.
# onboarding@resend.dev works for testing only.
RESEND_API_KEY=
CONTACT_EMAIL=a3powersportsllc@gmail.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Stripe — use a restricted key (rk_) with Checkout Sessions, Products, and Prices write.
# Create a separate sandbox for local development. Do not commit live or test keys.
STRIPE_SECRET_KEY=
# Signing secret from the webhook endpoint (required before taking real orders).
STRIPE_WEBHOOK_SECRET=
